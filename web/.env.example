# Copie para .env.local (para testar no computador) ou cadastre no painel da Netlify.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Endereço público do site, sem barra no final
NEXT_PUBLIC_SITE_URL=https://seu-site.netlify.app

# Anthropic Console > API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: modelo de IA (padrão claude-haiku-4-5)
# IA_MODELO=claude-haiku-4-5

# Asaas > Integrações > Chave de API
ASAAS_API_KEY=
# Testes: https://api-sandbox.asaas.com/v3 · Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Invente um token longo e use o mesmo no webhook do Asaas
ASAAS_WEBHOOK_TOKEN=

# Resend (e-mails de lembrete)
RESEND_API_KEY=
RESEND_FROM=Prospecta <lembretes@seudominio.com.br>

# Invente um segredo longo; o mesmo vai no GitHub (secret CRON_SECRET)
CRON_SECRET=

# Opcional: modelo que escreve as DMs e conduz a conversa no Instagram (padrão claude-sonnet-5-5)
# IA_MODELO_ESCRITA=claude-sonnet-5-5

# Instagram (Business Discovery): leitura automática da bio e dos posts pelo @
# Token do app da Meta (instagram_basic + pages_show_list) e o ID da sua conta comercial do Instagram
META_ACCESS_TOKEN=
IG_USER_ID=
# META_GRAPH_VERSION=v23.0
